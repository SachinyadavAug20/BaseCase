# Auth
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database (Atlas cluster — MongoDB Atlas Vector Search is required for semantic search)
MONGODB_URI=
MONGODB_DB_NAME=devflow

# Semantic search embeddings (OpenRouter)
# free model: nvidia/nemotron-3-embed-1b:free (2048 dims)
OPENROUTER_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSIONS=2048
# set true to skip auto-creating Atlas vector indexes
DISABLE_VECTOR_INDEX=

# AI answer feature (existing)
GOOGLE_GENERATIVE_AI_API_KEY=

# Public
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_RAPID_API_KEY=
NEXT_PUBLIC_INTERSHIP_RAPID_API_KEY=
